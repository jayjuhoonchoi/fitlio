# Leave empty when the browser loads the Next app from the same host as the API (reverse proxy).
# Otherwise set the public API origin, e.g. https://fitlio-jay.duckdns.org:8443
NEXT_PUBLIC_API_BASE_URL=

# Single-center launch (Gwanghwamun pilot)
NEXT_PUBLIC_CENTER_SLUG=gwanghwamun
NEXT_PUBLIC_CENTER_NAME=Fitlio Gwanghwamun
NEXT_PUBLIC_CENTER_TAGLINE=Boutique studio operations for the Gwanghwamun location.
